# Local BYO installation only. Do not overwrite an existing .env.local.
# Prefer the masked setup helpers; never commit or print credentials.
# The backend reads these keys. They are never returned to the browser.
OPENAI_API_KEY=
NEBIUS_API_KEY=
# Initial provider choice in the local UI: openai (default) or nebius.
# Each saved course keeps its own provider. Offline sample mode needs no key.
EASY_STREET_PROVIDER=openai
# Cumulative application allowance across both providers in this local database.
# This is not a provider-enforced billing cap. Defaults to $1.
EASY_STREET_BUDGET_USD=1.00
# Optional custom local data directory; omit to use data/ in this app folder.
# EASY_STREET_DATA_DIR=
# Hosted judging uses deploy/.env.judging.example and its separate entry point.
# Never copy a local environment file into a public deployment/image.
