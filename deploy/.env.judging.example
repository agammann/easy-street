# Secret-free configuration template. Do not put real credentials in this file.
# Runtime environment or the approved hosting secret manager only.
EASY_STREET_DEMO_ORIGIN=https://approved-host.example
EASY_STREET_DEMO_ALLOW_HTTP=0
EASY_STREET_DEMO_DATA_DIR=/var/lib/easy-street
EASY_STREET_DEMO_BUDGET_USD=0
EASY_STREET_DEMO_SESSION_BUDGET_USD=0.50
EASY_STREET_DEMO_RETENTION_HOURS=24
EASY_STREET_DEMO_MAX_SESSIONS=100
EASY_STREET_DEMO_MAX_CONCURRENT=2
EASY_STREET_DEMO_MAX_UPLOAD_MIB=5
EASY_STREET_DEMO_MAX_MODULES=3
EASY_STREET_DEMO_MAX_ASSIGNMENTS=3
EASY_STREET_DEMO_MAX_QUIZZES=3
EASY_STREET_DEMO_EXPIRES_AT=2026-12-16T08:00:00+00:00
EASY_STREET_JUDGE_PASSWORD_HASH=
EASY_STREET_OPERATOR_TOKEN=
NEBIUS_API_KEY=
# Optional, account-verified timestamp only. Does not assert a credit grant.
NEBIUS_CREDIT_EXPIRES_AT=
